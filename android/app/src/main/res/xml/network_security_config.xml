<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted ONLY for local development hosts.

  A blanket android:usesCleartextTraffic="true" would have been one line, and
  would also have allowed plaintext to every host in production. This keeps the
  default (HTTPS-only) intact and carves out exactly the addresses a developer
  machine uses:

    10.0.2.2        Android emulator's alias for the host machine
    10.0.3.2        Genymotion's equivalent
    localhost       on-device servers
    192.168.*       typical LAN addresses for a physical test device
                    (listed explicitly - this file does not support wildcards)

  If you test from a phone on a different subnet, add that address here rather
  than switching on global cleartext.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
